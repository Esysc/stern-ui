{
  "extends": ["config:base", ":dependencyDashboard", ":automergeDisabled"],
  "labels": ["dependencies", "automated pr"],
  "schedule": ["before 3am on monday"],
  "rangeStrategy": "bump",
  "vulnerabilityAlerts": {
    "labels": ["security", "dependencies"],
    "schedule": ["every day"],
    "automerge": true
  },
  "packageRules": [
    {
      "matchPackagePatterns": ["*"],
      "matchPaths": ["frontend/package.json"],
      "groupName": "frontend dependencies",
      "groupSlug": "frontend",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "matchPackagePatterns": ["*"],
      "matchPaths": ["go.mod"],
      "groupName": "go dependencies",
      "groupSlug": "go",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "matchPackagePatterns": ["*"],
      "matchPaths": ["Dockerfile"],
      "groupName": "docker base image",
      "groupSlug": "docker-base",
      "automerge": true,
      "automergeType": "pr",
      "schedule": ["before 3am on monday"]
    }
  ],
  "regexManagers": [
    {
      "description": "Update alpine base image in Dockerfile",
      "fileMatch": ["Dockerfile"],
      "matchStrings": [
        "FROM (\\S+)\\s*",
        "FROM (\\S+)\\s*\\s*#"
      ],
      "depNameTemplate": "alpine",
      "depTemplate": "alpine:{{#.}}",
      "extractVersionTemplate": "{{#extractVersion {{#url}},alpine,(.*),.*{{/url}}}}",
      "versioning": "docker"
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 3am on monday"],
    "automerge": false
  },
  "prConcurrentLimit": 3,
  "prHourlyLimit": 2
}
